# ==========================================
# 享宇AI智评 生产与开发环境配置模版 (.env.example)
# 使用方法：复制本文件为 .env 并按实际生产环境修改参数
# ==========================================

PROJECT_NAME="享宇AI智评"
VERSION="2.2.0"
API_V1_STR="/api/v1"
API_ADMIN_STR="/api/admin"

# 运行环境模式: "production" (生产严格模式) | "development" (本地开发沙箱模式)
ENVIRONMENT="production"

# 公网正式服务 HTTPS 域名 (必填！用于移动端扫码短链、二维码、对外分享和微风企授权回调，如 https://edd.yourcompany.com)
PUBLIC_BASE_URL="https://edd.yourcompany.com"

# ------------------------------------------
# 1. 数据库配置
# ------------------------------------------
# 生产推荐 MySQL 8.0 实例 (支持高并发连接池与多 worker 稳定运行):
DATABASE_URL="mysql+asyncmy://xyzp_user:YourStrongPassword@127.0.0.1:3306/xyzp_db?charset=utf8mb4"
# 本地单机轻量开发模式 (仅限单 worker，生产请勿开启):
# DATABASE_URL="sqlite+aiosqlite:///./data/xyzp_v6.db"
DB_ECHO=false

# ------------------------------------------
# 2. 缓存与分布式驱动配置
# ------------------------------------------
# 生产推荐独立 Redis:
CACHE_DRIVER="redis"
REDIS_URL="redis://:your_redis_password@127.0.0.1:6379/0"
# 本地极简开发模式 (单机进程内字典，生产禁止使用):
# CACHE_DRIVER="memory"

# ------------------------------------------
# 3. 三方数据源中台配置 (模式可选: "mock" | "http")
# ------------------------------------------
# 3.1 微风企涉税金税数据接口 (Weifengqi API)
WEIFENGQI_MODE="mock" # 切换至 "http" 时请配置正式生产凭证
WEIFENGQI_BASE_URL="https://api.weifengqi.com"
WEIFENGQI_APP_KEY="your_weifengqi_app_key"
WEIFENGQI_APP_SECRET="your_weifengqi_app_secret"
WEIFENGQI_TIMEOUT_SECONDS=15

# 3.2 企业政务工商数据接口 (Enterprise IC API)
IC_DATA_MODE="mock" # 切换至 "http" 时请接入商用工商数据供应商
IC_DATA_BASE_URL="https://api.your-ic-provider.com/v1"
IC_DATA_APP_KEY="your_ic_data_app_key"
IC_DATA_APP_SECRET="your_ic_data_app_secret"
IC_DATA_TIMEOUT_SECONDS=15

# 3.3 企业经营与司法涉诉合规雷达接口 (Risk Radar API)
RISK_DATA_MODE="mock" # 切换至 "http" 时请接入商用合规风控数据供应商
RISK_DATA_BASE_URL="https://api.your-risk-provider.com/v1"
RISK_DATA_APP_KEY="your_risk_radar_app_key"
RISK_DATA_APP_SECRET="your_risk_radar_app_secret"
RISK_DATA_TIMEOUT_SECONDS=15

# 3.4 享畅通三方短信发送网关 (XCT SMS - 手机号登录/注册/改密/重置密码验证码)
SMS_PROVIDER="xct"                      # 短信通道提供方: "xct" (享畅通官方网关) | "mock" (本地开发挡板)
XCT_SMS_URL="http://api.xct.com/sms/send" # 享畅通 HTTP GET 网关地址
XCT_SMS_NAME="your_xct_merchant_account"  # 享畅通分配的商户账号 (name)
XCT_SMS_KEY="your_xct_merchant_secret"    # 享畅通商户密码/密钥 (key)
XCT_SMS_SIGN="成都享宇森云科技"           # 享畅通短信签名 (与商户账号、密码/密钥一同配置，支持随时自定义)
XCT_SMS_IS_OPEN=false                    # 真实短信发送开关: false(挡板拦截防刷无资费) | true(生产真实扣费发送)
XCT_SMS_MAX_ERROR_COUNT=5                # 验证码最大输错容忍次数 (达到5次强制作废防撞库)
XCT_SMS_EXPIRE_SECONDS=300               # 验证码有效时长 (秒，默认 5 分钟)

# ------------------------------------------
# 4. MinIO 对象存储与不可篡改存证配置
# ------------------------------------------
MINIO_ENDPOINT="127.0.0.1:9000"
MINIO_ACCESS_KEY="your_minio_admin"
MINIO_SECRET_KEY="your_minio_password"
MINIO_BUCKET_NAME="my-files"
MINIO_SECURE=false # 生产若启用 HTTPS 则设为 true

# ------------------------------------------
# 5. LLM 大模型与 New-API 聚合网关配置
# ------------------------------------------
LLM_PROVIDER="newapi"  # "mock" | "newapi" | "openai" | "deepseek"
NEW_API_BASE_URL="http://127.0.0.1:3000/v1"
NEW_API_KEY="sk-your-new-api-production-token"
NEW_API_MODEL="xyzp-ai" # 由 New-API 渠道自动重定向映射至真实底层模型 (如 deepseek-chat)
NEW_API_TIMEOUT_SECONDS=60

# 兼容通用 OpenAI 变量:
OPENAI_API_KEY=""
OPENAI_API_BASE="http://127.0.0.1:3000/v1"

# ------------------------------------------
# 6. 安全与跨域白名单配置
# ------------------------------------------
# 生产必须替换为大于 64 位的强伪随机密钥 (可通过 python -c 'import secrets; print(secrets.token_urlsafe(64))' 生成):
SECRET_KEY="replace-this-with-a-very-long-and-cryptographically-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# 生产必须指定受信任的正式前端域名 (逗号分隔，禁止使用通配符):
CORS_ORIGINS="https://edd.yourcompany.com,https://admin.yourcompany.com"

# 生产环境是否允许模拟充值支付 (生产环境强制为 false 杜绝免费刷单):
ALLOW_MOCK_PAY=false

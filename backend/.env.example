# ==========================================
# 享宇AI智评 环境配置模版 (.env.example)
# 使用方法：复制本文件为 .env 并按实际环境修改参数
# ==========================================

PROJECT_NAME="享宇AI智评"
VERSION="2.1.0"
API_V1_STR="/api/v1"
API_ADMIN_STR="/api/admin"

# 公网/局域网真实服务 IP 或域名 (用于短链生成、二维码、对外分享和微风企授权回调，如 http://192.168.110.234:8000)
PUBLIC_BASE_URL=""

# ------------------------------------------
# 1. 数据库配置
# ------------------------------------------
# SQLite 模式 (默认开箱即用):
DATABASE_URL="sqlite+aiosqlite:///./data/edd_v6.db"
# MySQL 生产模式示例 (需安装 asyncmy / aiomysql):
# DATABASE_URL="mysql+asyncmy://root:password@127.0.0.1:3306/edd_db?charset=utf8mb4"
DB_ECHO=false

# ------------------------------------------
# 2. 缓存驱动配置
# ------------------------------------------
# 内存缓存模式 (默认零外部依赖):
CACHE_DRIVER="memory"
# 独立 Redis 模式:
# CACHE_DRIVER="redis"
# REDIS_URL="redis://:your_password@localhost:6379/0"
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------
# 3. 三方数据源中台配置 (可选: "mock" | "http")
# ------------------------------------------
# 3.1 微风企金税数据接口 (Weifengqi API)
WEIFENGQI_MODE="mock"
WEIFENGQI_BASE_URL="https://api.weifengqi.com"
WEIFENGQI_APP_KEY="your_weifengqi_app_key"
WEIFENGQI_APP_SECRET="your_weifengqi_app_secret"
WEIFENGQI_TIMEOUT_SECONDS=15

# 3.2 企业工商数据接口 (Enterprise IC API)
IC_DATA_MODE="mock"
IC_DATA_BASE_URL="https://api.enterprise-data.com/ic/v1"
IC_DATA_APP_KEY="your_ic_data_app_key"
IC_DATA_APP_SECRET="your_ic_data_app_secret"
IC_DATA_TIMEOUT_SECONDS=15

# 3.3 企业经营与司法风险数据接口 (Risk Radar API)
RISK_DATA_MODE="mock"
RISK_DATA_BASE_URL="https://api.risk-radar.com/v1"
RISK_DATA_APP_KEY="your_risk_radar_app_key"
RISK_DATA_APP_SECRET="your_risk_radar_app_secret"
RISK_DATA_TIMEOUT_SECONDS=15

# ------------------------------------------
# 4. MinIO 对象存储配置 (必须启动 MinIO 或配置 S3 兼容服务)
# ------------------------------------------
MINIO_ENDPOINT="127.0.0.1:9000"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="admin123456"
MINIO_BUCKET_NAME="my-files"
MINIO_SECURE=false

# ------------------------------------------
# 5. LLM 大模型与 New-API 网关配置
# ------------------------------------------
LLM_PROVIDER="newapi"  # "mock" | "newapi" | "openai" | "deepseek"
NEW_API_BASE_URL="http://127.0.0.1:3000/v1"
NEW_API_KEY="sk-newapi-master-key"
NEW_API_MODEL="deepseek-chat"
NEW_API_TIMEOUT_SECONDS=60

# 兼容通用 OpenAI 变量:
OPENAI_API_KEY=""
OPENAI_API_BASE="http://127.0.0.1:3000/v1"

# ------------------------------------------
# 6. 安全与跨域配置
# ------------------------------------------
SECRET_KEY="xiangyu-ai-smartscore-jwt-secret-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=4320
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# ==========================================
# 享宇AI智评 前端环境配置模版 (.env.example)
# 使用方法：复制本文件为 .env 并按实际环境修改参数
# ==========================================

# ------------------------------------------
# 方式一：Vite 本地开发代理转发目标后端地址 (推荐开发环境使用)
# ------------------------------------------
# 当未设置 VITE_API_BASE_URL 时，前端所有的 /api 请求将由 Vite 自动反向代理转发至此后端地址
VITE_API_TARGET="http://127.0.0.1:8000"

# ------------------------------------------
# 方式二：直连后端 API 根地址 (适合前后端跨域直连)
# ------------------------------------------
# 若设置了此变量，Axios 会跳过相对路径 /api，直接向该完整地址发起网络请求
# VITE_API_BASE_URL="http://192.168.110.234:8000/api"

# ==========================================
# EDD AI Platform 本地极简轻量配置模版 (.env.example)
# ==========================================

PROJECT_NAME="EDD AI Platform"
VERSION="2.1.0"
API_V1_STR="/api/v1"
API_ADMIN_STR="/api/admin"

# 数据库配置
DATABASE_URL="sqlite+aiosqlite:///./data/edd_dev.db"
DB_ECHO=false

# 缓存配置 (memory / redis)
CACHE_DRIVER="memory"
REDIS_URL="redis://localhost:6379/0"

# 数据中台配置 (mock / real)
DATA_PROVIDER="mock"

# AI 大模型引擎 (mock / deepseek)
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.deepseek.com/v1"

# JWT 安全密钥
SECRET_KEY="edd-ai-platform-super-secure-local-dev-jwt-secret-key-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# CORS 跨域白名单
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
